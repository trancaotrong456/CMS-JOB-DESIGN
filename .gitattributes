# Text files use stable line endings across Windows and Unix checkouts.
* text=auto

*.php text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sql text eol=lf
*.pot text eol=lf
*.po text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mo binary
